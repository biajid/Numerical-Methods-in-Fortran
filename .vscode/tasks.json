{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "build current Fortran file",
            "type": "shell",
            "command": "gfortran",
            "args": [
                "-g",
                "-O0",
                "${file}",
                "-o",
                "${workspaceFolder}/${fileBasenameNoExtension}"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": "$gcc"
        }
    ]
}
